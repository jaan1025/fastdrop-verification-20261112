      "name": "PenaltyConfig",
      "docs": [
        "Configuration for the linear penalty hook.",
        "Tokens claimed before `end_time` incur a linear penalty that stays in the vault."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "distributor",
            "docs": ["The distributor this config belongs to"],
            "type": "pubkey"
          },
          {
            "name": "configurator",
            "docs": ["The configurator identifier"],
            "type": {
              "array": ["u8", 32]
            }
          },
          {
            "name": "begin_time",
            "docs": ["Penalty window start (unix timestamp). Claims before this get 100% penalty."],
            "type": "i64"
          },
          {
            "name": "end_time",
            "docs": [
              "Penalty window end (unix timestamp). Claims at or after this get end_penalty_bps penalty."
            ],
            "type": "i64"
          },
          {
            "name": "start_penalty",
            "docs": ["Penalty proportion at begin_time (WAD, 1_000_000_000 = 100%)"],
            "type": "u64"
          },
          {
            "name": "end_penalty",
            "docs": ["Penalty proportion at end_time (WAD, 1_000_000_000 = 100%)"],
            "type": "u64"
          },
          {
            "name": "bump",
            "docs": ["PDA bump"],
            "type": "u8"
          }
        ]
      }
