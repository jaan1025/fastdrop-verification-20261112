  "types": [
    {
      "name": "BatchConfig",
      "docs": [
        "Batch configuration for distributing tokens through multiple hooks",
        "PDA seeds: [BatchConfig::SEED, distributor, configurator]",
        "where configurator is from ClaimRoot.configurator"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "fallback_hook",
            "docs": [
              "Index of the fallback hook (receives remaining amount after all other hooks)",
              "Must be a valid index when strategies is not empty"
            ],
            "type": "u8"
          },
          {
            "name": "strategies",
            "docs": ["The strategies in this batch configuration"],
            "type": {
              "vec": {
                "defined": {
                  "name": "Strategy"
                }
              }
            }
          },
          {
            "name": "bump",
            "docs": ["Bump seed for PDA"],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ClaimRoot",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "distributor",
            "docs": ["The distributor of the claim root."],
